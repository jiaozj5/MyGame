{
  "schema_version":"0.1.0",
  "ruleset_id":"smalltown-v0.1",
  "events":[
    {
      "id":"friend.loan_request","version":1,"title":"朋友的请求","setting_id":"smalltown","trigger":"ambient",
      "age_range":[18,80],"actors":{"friend":{"relation":"friend","alive":true,"same_location":true}},
      "preconditions":[{"path":"facts.friend_request_open","op":"eq","value":true},{"path":"facts.friend_request_person","op":"eq","value":{"ref":"friend.id"}},{"path":"friend.cash","op":"lte","value":{"ref":"friend.housing_reserve"}}],
      "description":"{friend.name}请求借400元周转。你现在有{player.cash}元，计划保留{player.housing_reserve}元用于住处；这只是本原型中的预算目标，尚未模拟实际租金支出。",
      "context_tags":["adult","friend","financial_pressure"],
      "choices":[
        {"id":"lend_full","label":"借出400元","requirements":[{"path":"player.cash","op":"gte","value":400}],
         "effects":[{"op":"transfer","from":"player","to":"friend","amount":400},{"op":"create_loan","creditor":"player","debtor":"friend","amount":400,"due_in_days":30},{"op":"adjust_relation","from":"friend","to":"player","field":"trust","delta":4},{"op":"set_fact","key":"friend_request_open","value":false}],
         "evidence":[{"dimension_id":"care","behavior":"material_support","strength":"limited"},{"dimension_id":"risk_taking","behavior":"accept_financial_exposure","strength":"limited"}]},
        {"id":"lend_partial","label":"借出100元，并说明自己的预算","requirements":[{"path":"player.cash","op":"gte","value":100}],
         "effects":[{"op":"transfer","from":"player","to":"friend","amount":100},{"op":"create_loan","creditor":"player","debtor":"friend","amount":100,"due_in_days":30},{"op":"set_fact","key":"friend_request_open","value":false}],
         "evidence":[{"dimension_id":"care","behavior":"partial_material_support","strength":"limited"},{"dimension_id":"risk_taking","behavior":"limit_financial_exposure","strength":"limited"}]},
        {"id":"help_search","label":"花时间一起寻找其他办法","requirements":[{"path":"player.energy","op":"gte","value":10}],
         "effects":[{"op":"adjust","actor":"player","field":"energy","delta":-10},{"op":"set_fact","key":"alternative_help_attempted","value":true},{"op":"set_fact","key":"friend_request_open","value":false}],
         "evidence":[{"dimension_id":"care","behavior":"practical_support_attempt","strength":"limited"}]},
        {"id":"decline","label":"说明目前无法借钱","requirements":[],
         "effects":[{"op":"set_fact","key":"friend_request_open","value":false}],
         "evidence":[{"dimension_id":"care","behavior":"declined_this_request","strength":"ambiguous"}]}
      ]
    },
    {
      "id":"friend.loan_due","version":1,"title":"约定的还款日","setting_id":"smalltown","trigger":"scheduled",
      "age_range":[0,120],"actors":{"friend":{"relation":"friend","alive":true,"same_location":false}},
      "preconditions":[{"path":"loan.status","op":"eq","value":"outstanding"}],
      "description":"{friend.name}的{loan.amount}元借款已经到期。只有对方仍健在、愿意履约且拥有足够资金，按约还款才可执行；你也可以延长期限或暂时结束催促。",
      "context_tags":["friend","existing_promise"],
      "choices":[
        {"id":"accept_repayment","label":"接受对方按约还款","requirements":[{"path":"friend.repayment_willing","op":"eq","value":true},{"path":"friend.cash","op":"gte","value":{"ref":"loan.amount"}}],"effects":[{"op":"settle_loan"}],"evidence":[]},
        {"id":"extend","label":"同意再等7天","requirements":[],"effects":[{"op":"reschedule_loan","days":7}],"evidence":[{"dimension_id":"conflict_style","behavior":"negotiated_extension","strength":"limited"}]},
        {"id":"leave_claim","label":"暂时结束催促，保留债权记录","requirements":[],"effects":[],"evidence":[{"dimension_id":"conflict_style","behavior":"deferred_confrontation","strength":"ambiguous"}]}
      ]
    },
    {
      "id":"friend.old_letter","version":1,"title":"留下的信","setting_id":"smalltown","trigger":"ambient",
      "age_range":[0,120],"actors":{"friend":{"relation":"friend","alive":false,"same_location":false}},
      "preconditions":[{"path":"artifacts.letter_f.author","op":"eq","value":{"ref":"friend.id"}},{"path":"facts.letter_handled","op":"eq","value":false}],
      "description":"{friend.name}生前留下的信已经存在于世界记录中。信里只引用他写信时已知的一次共同经历。",
      "context_tags":["friend","bereavement"],
      "choices":[
        {"id":"read","label":"读完并收好这封信","requirements":[],"effects":[{"op":"set_fact","key":"letter_read","value":true},{"op":"set_fact","key":"letter_handled","value":true}],"evidence":[]},
        {"id":"keep","label":"先收好，暂时不读","requirements":[],"effects":[{"op":"set_fact","key":"letter_handled","value":true}],"evidence":[]}
      ]
    }
  ]
}
